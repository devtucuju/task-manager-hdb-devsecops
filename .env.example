# =============================================================================
# .env.example — Task Manager DevSecOps
# =============================================================================
# Copie este arquivo para .env e ajuste os valores antes de subir o stack:
#   cp .env.example .env
#
# O docker-compose carrega automaticamente variáveis deste arquivo (.env).
# Nunca commite o arquivo .env (já está no .gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Flask
# -----------------------------------------------------------------------------

# Módulo/ponto de entrada da aplicação Flask.
# Neste repositório o objeto `app` está em todo_project/todo_project/__init__.py,
# portanto o valor efetivo usado no Docker é `todo_project` (ver docker-compose).
FLASK_APP=app.py

# Ambiente de execução: development | production
FLASK_ENV=production

# Chave secreta para sessões, CSRF e cookies assinados (obrigatório alterar!)
SECRET_KEY=sua-chave-secreta-aqui

# Modo debug da aplicação (False em produção)
DEBUG=False

# Variáveis internas do Python (recomendado manter)
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# -----------------------------------------------------------------------------
# 2. Banco de Dados (PostgreSQL)
# -----------------------------------------------------------------------------

# URI completa de conexão (usada pela aplicação Flask-SQLAlchemy)
DATABASE_URL=postgresql://taskmanager:senha123@db:5432/taskmanager

# Credenciais individuais (usadas pelo serviço db do docker-compose)
DB_USER=taskmanager
DB_PASSWORD=senha123
DB_NAME=taskmanager

# Aliases para o container PostgreSQL (docker-compose → serviço db)
POSTGRES_USER=taskmanager
POSTGRES_PASSWORD=senha123
POSTGRES_DB=taskmanager

# Compatibilidade com configuração Flask-SQLAlchemy explícita
SQLALCHEMY_DATABASE_URI=postgresql://taskmanager:senha123@db:5432/taskmanager

# -----------------------------------------------------------------------------
# 3. Logging (rsyslog)
# -----------------------------------------------------------------------------

# Hostname do serviço syslog na rede Docker Compose
SYSLOG_HOST=syslog

# Porta UDP do coletor rsyslog
SYSLOG_PORT=514

# Nível de log da aplicação: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# 4. Aplicação
# -----------------------------------------------------------------------------

# Nome exibido da aplicação (metadados / health checks futuros)
APP_NAME=Task Manager DevSecOps

# Versão semver da aplicação
APP_VERSION=1.0.0

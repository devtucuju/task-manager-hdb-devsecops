# =============================================================================
# .env.staging.example — Task Manager DevSecOps (homologação / staging)
# =============================================================================
# Copie e ajuste antes de subir o stack de staging:
#   cp .env.staging.example .env.staging
#
# Uso com Docker Compose:
#   docker compose -f docker-compose.staging.yml --env-file .env.staging up -d
#
# Nunca commite o arquivo .env.staging (contém segredos reais).
# =============================================================================

# -----------------------------------------------------------------------------
# 0. Imagem Docker (substituição no docker-compose.staging.yml)
# -----------------------------------------------------------------------------

# Imagem publicada no registry — ajuste o namespace do seu usuário/organização
DOCKER_IMAGE=docker.io/seu-usuario/task-manager:latest

# Porta exposta no host (opcional; padrão 5000 no compose)
# APP_PORT=5000

# -----------------------------------------------------------------------------
# 1. Flask
# -----------------------------------------------------------------------------

FLASK_APP=todo_project
FLASK_ENV=staging

# Obrigatório: gere com `openssl rand -hex 32` antes do deploy real
SECRET_KEY=staging-altere-esta-chave-antes-do-deploy

DEBUG=False
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# -----------------------------------------------------------------------------
# 2. Banco de Dados (PostgreSQL)
# -----------------------------------------------------------------------------
# Host `db` é o nome do serviço na rede staging-network.

POSTGRES_USER=taskmanager_staging
POSTGRES_PASSWORD=altere-senha-forte-staging
POSTGRES_DB=taskmanager_staging

DATABASE_URL=postgresql://taskmanager_staging:altere-senha-forte-staging@db:5432/taskmanager_staging
SQLALCHEMY_DATABASE_URI=postgresql://taskmanager_staging:altere-senha-forte-staging@db:5432/taskmanager_staging

# -----------------------------------------------------------------------------
# 3. Logging (rsyslog)
# -----------------------------------------------------------------------------

SYSLOG_ENABLED=true
SYSLOG_HOST=syslog
SYSLOG_PORT=514
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# 4. JWT e sessão
# -----------------------------------------------------------------------------

JWT_ALGORITHM=HS256
JWT_EXPIRES_HOURS=8
JWT_COOKIE_NAME=access_token
# true se staging estiver atrás de HTTPS; false para HTTP local
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=Lax

# -----------------------------------------------------------------------------
# 5. Aplicação
# -----------------------------------------------------------------------------

APP_NAME=Task Manager DevSecOps (Staging)
APP_VERSION=1.0.0

# Rate limiting — login (mais permissivo que produção para testes de carga leves)
LOGIN_RATE_LIMIT=20 per 15 minutes

# -----------------------------------------------------------------------------
# 6. Autenticação (bootstrap e registro)
# -----------------------------------------------------------------------------
# Em staging o registro costuma ficar habilitado para QA validar fluxos.
# Desligue (false) se quiser espelhar produção.

REGISTRATION_ENABLED=true

# Bootstrap one-time: cria admin apenas com banco vazio.
# Permitido em staging (FLASK_ENV != production).
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_EMAIL=admin-staging@example.com
BOOTSTRAP_ADMIN_PASSWORD=Change-me1!
BOOTSTRAP_ADMIN_ALLOW_PRODUCTION=false

# -----------------------------------------------------------------------------
# Notas
# -----------------------------------------------------------------------------
# • Se alterar POSTGRES_PASSWORD/POSTGRES_DB após o primeiro up, recrie o volume:
#     docker compose -f docker-compose.staging.yml down -v
#     docker compose -f docker-compose.staging.yml --env-file .env.staging up -d
#
# • Health check da aplicação: GET http://localhost:5000/about (HTTP 200)
#
# • Logs do rsyslog persistem no volume nomeado logs_staging
